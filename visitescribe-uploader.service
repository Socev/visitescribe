[Unit]
Description=VisiteScribe v0.2 upload queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=visitescribe
Group=visitescribe
UMask=0077
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/visitescribe/uploader.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/visitescribe
ReadOnlyPaths=/etc/visitescribe

[Install]
WantedBy=multi-user.target
